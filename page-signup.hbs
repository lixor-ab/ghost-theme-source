{{!< default}}

{{#get "pages" filter="slug:hero-signup"}}
    {{#foreach pages}}
        <section class="gh-outer hero-signup">
            <div class="gh-inner">
                {{{html}}}
            </div>
        </section>
    {{/foreach}}
{{/get}}

{{#post}}
    <main class="gh-main">
        <article class="gh-article {{post_class}}">
            <section class="gh-content gh-canvas is-body">
                {{content}}
            </section>
        </article>
    </main>
{{/post}}
