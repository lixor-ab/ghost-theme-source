{{!< default}}

{{#get "pages" filter="slug:landing-hero"}}
    {{#foreach pages}}
        <section class="gh-outer landing-hero">
            <div class="gh-inner">
                {{{html}}}
            </div>
        </section>
    {{/foreach}}
{{/get}}

{{#post}}
    <main class="gh-main">
        <article class="gh-article {{post_class}}">
            <section class="gh-content gh-canvas is-body">
                {{content}}
            </section>
        </article>
    </main>
{{/post}}
